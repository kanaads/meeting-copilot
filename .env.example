# Groq API key — entered by user in the Settings UI at runtime.
# Do NOT hardcode this. It is passed as a request header per call.
# GROQ_API_KEY=gsk_...

# ── Debug mode ──────────────────────────────────────────────────────────────
# Set to "true" to enable detailed terminal logs for every suggestion
# and chat call. Shows meeting type, moment detection, context layers,
# last 3 sentences, and generated suggestions.
# Set to "false" or remove entirely in production.
DEBUG=false
